spring:
  application:
    name: text-vectorizer

  batch:
    job:
      enabled: false
    jdbc:
      initialize-schema: always

  datasource:
    url: jdbc:h2:file:./data/textvectorizer-db;AUTO_SERVER=TRUE
    driver-class-name: org.h2.Driver
    username: sa
    password:

  sql:
    init:
      mode: always

  h2:
    console:
      enabled: true
      path: /h2-console

  ai:
    openai-sdk:
      base-url: ${ionos.open-ai-base-url}
      api-key: ${ionos.api-key}
      embedding:
        options:
          model: ${ionos.embedding-model}
          encoding-format: float
          
      # openai:
      # api-key: ${ionos.api-key}
      # base-url: ${ionos.open-ai-base-url}
      # embedding:
      #   options:
      #     model: ${ionos.embedding-model}
      #     encoding-format: float
management:
  endpoints:
    web:
      exposure:
        include: health,info,metrics,loggers

logging:
  level:
    root: INFO
    com.example.textvectorizer: DEBUG
    org.springframework.batch: INFO
    org.springframework.web.reactive.function.client: INFO
  pattern:
    console: "%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [%X{jobId:-},%X{stepName:-},%X{fileName:-},%X{chunkIndex:-}] %logger{36} - %msg%n"

app:
  input-directory: ./input
  chunk-sentence-window-size: 5
  chunk-sentence-overlap: 1
  fallback-chunk-size: 1200
  fallback-chunk-overlap: 150
  recursive-scan: false

ionos:
  #old: api-key: ${IONOS_API_KEY:dummy-key-for-startup}
  api-key: ${API_KEY_FROM_FILE}
  #alt: pen-ai-base-url: ${IONOS_OPENAI_BASE_URL:https://openai.inference.de-txl.ionos.com/v1/embeddings}
  open-ai-base-url: ${IONOS_OPENAI_BASE_URL:https://openai.inference.de-txl.ionos.com/v1}
  native-base-url: ${IONOS_NATIVE_BASE_URL:https://openai.inference.de-txl.ionos.com/v1/embeddings}
  embedding-model: ${IONOS_EMBEDDING_MODEL:BAAI/bge-m3}
  document-collection-id: ${IONOS_DOCUMENT_COLLECTION_ID:placeholder-collection-id}
  dry-run: true

vector-db:
  jdbc-url: jdbc:postgresql://localhost:5435/textvectorizer
  username: textvectorizer
  password: textvectorizer